<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:background="@color/bg_base">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER BAR (Windows App Style) -->
        <LinearLayout
            android:id="@+id/app_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <!-- Brand Icon -->
            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_brand_icon"
                android:src="@drawable/ic_lightning"
                android:padding="8dp"
                android:contentDescription="HSCast Brand Icon" />

            <!-- Brand Title & Badge -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HSCast"
                        android:textColor="@color/text_main"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_badge_pill"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="ANDROID PRO"
                        android:textColor="@color/accent_green_dark"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Screen Casting Studio"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Header Status Pill -->
            <TextView
                android:id="@+id/statusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_status_idle"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="● Idle"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- MAIN VIEW SWITCHER -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- HOME CONTAINER -->
            <LinearLayout
                android:id="@+id/homeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- CARD 1: PHONE SCREEN TO PC -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Phone screen to PC"
                        android:textColor="@color/text_main"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="12dp"
                        android:text="1. CONNECTION METHOD"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <!-- Segmented Radio Group (Wi-Fi vs USB) -->
                    <RadioGroup
                        android:id="@+id/modeRadioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_pill_status_idle"
                        android:padding="4dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="12dp">

                        <RadioButton
                            android:id="@+id/modeWifi"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:button="@null"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:background="@drawable/bg_segment_option"
                            android:textColor="@color/color_segment_text"
                            android:text="Wi-Fi Network"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <RadioButton
                            android:id="@+id/modeUsb"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:button="@null"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:background="@drawable/bg_segment_option"
                            android:textColor="@color/color_segment_text"
                            android:text="USB Cable"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </RadioGroup>

                    <!-- Connection Info Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_pill_status_idle"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/deviceIp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Device IP: Loading..."
                            android:textColor="@color/text_main"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/devicePorts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="2dp"
                            android:text="Ports: 8765 (Video), 8766 (Control)"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/howToConnectBtn"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How to Connect from PC"
                        android:textColor="@color/accent_green_dark"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/senderHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        android:paddingBottom="12dp"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:visibility="gone"
                        android:text="On the PC run:  python -m hscast mirror" />

                    <!-- Primary Action Button -->
                    <Button
                        android:id="@+id/toggleCast"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:paddingVertical="12dp"
                        android:text="Start Mirroring"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- Configuration Button -->
                    <Button
                        android:id="@+id/openConfigBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Configuration &amp; Quality Settings"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- CARD 2: PC DESKTOP ON THIS PHONE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PC desktop on this phone"
                        android:textColor="@color/text_main"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="12dp"
                        android:text="2. RECEIVER (DESKTOP TO PHONE)"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <!-- Receiver Segmented Radio Group (Wi-Fi vs USB) -->
                    <RadioGroup
                        android:id="@+id/receiverModeRadioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_pill_status_idle"
                        android:padding="4dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="12dp">

                        <RadioButton
                            android:id="@+id/receiverModeWifi"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:button="@null"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:background="@drawable/bg_segment_option"
                            android:textColor="@color/color_segment_text"
                            android:text="Wi-Fi Network"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <RadioButton
                            android:id="@+id/receiverModeUsb"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:button="@null"
                            android:gravity="center"
                            android:paddingVertical="8dp"
                            android:background="@drawable/bg_segment_option"
                            android:textColor="@color/color_segment_text"
                            android:text="USB Cable"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </RadioGroup>

                    <Button
                        android:id="@+id/howToConnectReceiverBtn"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How to Connect from PC"
                        android:textColor="@color/accent_green_dark"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/receiverHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="4dp"
                        android:paddingBottom="12dp"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:visibility="gone"
                        android:text="On the PC run:  python -m hscast desktop --wifi\nThen enter that PC's address below. Over USB the host is 127.0.0.1." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <!-- PC Address Row (Full Width Input) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="4dp">

                            <TextView
                                android:layout_width="110dp"
                                android:layout_height="wrap_content"
                                android:text="PC Address:"
                                android:textColor="@color/text_main"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <AutoCompleteTextView
                                android:id="@+id/host"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:hint="127.0.0.1 or select PC IP"
                                android:inputType="text"
                                android:completionThreshold="1"
                                android:importantForAutofill="no" />
                        </LinearLayout>

                        <!-- Scan PCs Button (Below PC Address Field) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="end"
                            android:layout_marginBottom="8dp">

                            <Button
                                android:id="@+id/scanPcsBtn"
                                style="?android:attr/borderlessButtonStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Scan PCs"
                                android:textColor="@color/accent_green_dark"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Port Number Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="110dp"
                                android:layout_height="wrap_content"
                                android:text="Port Number:"
                                android:textColor="@color/text_main"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/port"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:hint="8767"
                                android:inputType="number"
                                android:importantForAutofill="no" />
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/receive"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Show PC Desktop"
                        android:textColor="@color/white" />
                </LinearLayout>

                <!-- CARD 3: REMOTE INPUT CONTROL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Remote Input Control"
                        android:textColor="@color/text_main"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="12dp"
                        android:text="3. ACCESSIBILITY &amp; INPUT"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/inputState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="12dp"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:text="Remote input: unknown" />

                    <Button
                        android:id="@+id/enableInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enable Mouse &amp; Keyboard Control"
                        android:textColor="@color/white" />
                </LinearLayout>

            </LinearLayout>

            <!-- CONFIGURATION CONTAINER -->
            <LinearLayout
                android:id="@+id/configContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Stream Configuration"
                    android:textColor="@color/text_main"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="16dp"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:text="Adjust video encoding parameters for screen casting." />

                <!-- Stream Configuration Fields -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <!-- FPS Field -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="FPS (Frame Rate):"
                            android:textColor="@color/text_main"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <AutoCompleteTextView
                            android:id="@+id/fps"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="e.g. 60"
                            android:inputType="number"
                            android:completionThreshold="1"
                            android:importantForAutofill="no" />
                    </LinearLayout>

                    <!-- Bitrate Field -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Bitrate (Mb/s):"
                            android:textColor="@color/text_main"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <AutoCompleteTextView
                            android:id="@+id/bitrate"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="e.g. 8"
                            android:inputType="numberDecimal"
                            android:completionThreshold="1"
                            android:importantForAutofill="no" />
                    </LinearLayout>

                    <!-- Max Size Field -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Max Size (px):"
                            android:textColor="@color/text_main"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <AutoCompleteTextView
                            android:id="@+id/maxSize"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:hint="e.g. 1600"
                            android:inputType="number"
                            android:completionThreshold="1"
                            android:importantForAutofill="no" />
                    </LinearLayout>
                </LinearLayout>

                <CheckBox
                    android:id="@+id/hevc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingBottom="16dp"
                    android:text="Use HEVC (smaller, needs a capable phone)" />

                <Button
                    android:id="@+id/backBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="← Back to Home"
                    android:textColor="@color/white" />
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>
</ScrollView>
