<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone screen to PC"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/senderHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:textSize="13sp"
            android:text="On the PC run:  python -m hscast mirror" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/fps"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="fps"
                android:inputType="number"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/bitrate"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="Mb/s"
                android:inputType="numberDecimal"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/maxSize"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="max px"
                android:inputType="number"
                android:importantForAutofill="no" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/hevc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Use HEVC (smaller, needs a capable phone)" />

        <Button
            android:id="@+id/startCast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start casting to PC" />

        <Button
            android:id="@+id/stopCast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop casting" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PC desktop on this phone"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:textSize="13sp"
            android:text="On the PC run:  python -m hscast desktop --wifi\nThen enter that PC's address below. Over USB the host is 127.0.0.1." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/host"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content"
                android:hint="PC address"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/port"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:hint="port"
                android:inputType="number"
                android:importantForAutofill="no" />
        </LinearLayout>

        <Button
            android:id="@+id/receive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show PC desktop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:id="@+id/inputState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:textSize="13sp"
            android:text="Remote input: unknown" />

        <Button
            android:id="@+id/enableInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable mouse and keyboard control" />
    </LinearLayout>
</ScrollView>
